# Copy to .env and fill in. Real .env is git-ignored.

# PostgreSQL — Prisma Client (runtime) uses DATABASE_URL via lib/db.ts.
# Local Docker (docker-compose.yml):
DATABASE_URL="postgresql://digo:digo@localhost:5432/digo_academy?schema=public"

# Supabase Postgres (when you switch off Docker):
# DATABASE_URL = Transaction pooler (port 6543) — app runtime / Next.js
# DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL = Session pooler (port 5432) — prisma migrate / db push / seed
# DIRECT_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"
# Do NOT use db.[REF].supabase.co on IPv4-only networks (IPv6-only / pool limits).
DIRECT_URL=""

# Better Auth — generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth (optional — leave blank to disable Google login)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Google Meet integration (optional — leave blank to disable). Separate OAuth
# client with the Calendar API "calendar.events" scope enabled, used to create
# Meet-enabled Calendar events for LiveClass. Create it in Google Cloud Console
# (a distinct client from GOOGLE_CLIENT_ID above, or the same project) with an
# authorized redirect URI of {BETTER_AUTH_URL}/api/google-meet/callback, then
# connect the shared Google account once from /admin/settings.
GOOGLE_MEET_CLIENT_ID=""
GOOGLE_MEET_CLIENT_SECRET=""

# Mandatory MFA for instructors/admins. On by default; set to "false" to skip
# the forced 2FA enrollment in local development. Keep it on (or unset) in prod.
ENFORCE_MFA="true"

# S3 / object storage. Local dev uses MinIO (docker-compose) with the values
# below; in production point these at a real AWS S3 bucket and drop S3_ENDPOINT /
# S3_FORCE_PATH_STYLE. Uploads are disabled until bucket + credentials are set.
S3_BUCKET="digo-academy"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_ENDPOINT="http://localhost:9000"
S3_FORCE_PATH_STYLE="true"

# Supabase (optional). Used for Storage / Realtime / PostgREST via @supabase/ssr.
# App auth stays Better Auth. Prisma still uses DATABASE_URL (local Docker or
# Supabase Postgres connection string).
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# When pointing Prisma at Supabase Postgres, also set DIRECT_URL to the direct
# (non-pooler) connection for migrations:
# DATABASE_URL="postgresql://...@...pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://...@db.<ref>.supabase.co:5432/postgres"


# Transactional email via AWS SES. Leave SES_REGION blank in dev to log emails
# to the console. EMAIL_FROM must be a verified SES identity.
SES_REGION=""
SES_ACCESS_KEY_ID=""
SES_SECRET_ACCESS_KEY=""
EMAIL_FROM="Digo Academy <no-reply@digo.academy>"
